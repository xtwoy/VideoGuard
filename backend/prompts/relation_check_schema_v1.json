{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoGuard-E relation check response (typed answers, runtime contract)",
  "description": "Mirrors what src/relation_client.validate_response actually reads: JEV typed state/questions answers, one choice question and one noul question per pair.",
  "type": "object",
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "choice", "confidence", "probabilities"],
            "properties": {
              "type": {"const": "choice"},
              "choice": {"enum": ["encourages_same", "warns_same", "unrelated", "insufficient"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "probabilities": {
                "type": "object",
                "required": ["encourages_same", "warns_same", "unrelated", "insufficient"],
                "additionalProperties": false,
                "properties": {
                  "encourages_same": {"type": "number", "minimum": 0, "maximum": 1},
                  "warns_same": {"type": "number", "minimum": 0, "maximum": 1},
                  "unrelated": {"type": "number", "minimum": 0, "maximum": 1},
                  "insufficient": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["type", "noul"],
            "properties": {
              "type": {"const": "noul"},
              "noul": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        ]
      }
    }
  }
}
