# Secrets only on your own machine. Do not commit backend/.env.
# OpenAI-compatible endpoint used by the replaceable video parsing and audit-report stages.
VIDEO_MODEL_API_KEY=
VIDEO_MODEL_BASE_URL=
VIDEO_PARSE_MODEL=
AUDIT_REPORT_MODEL=
# Required on the LIVE path: problem-location adapter (separate from optional relation check).
ISSUE_LOCATOR_API_KEY=
ISSUE_LOCATOR_ENDPOINT=https://api.typesafe.ai/v1/systemone
ISSUE_LOCATOR_MODEL=
# Optional relation-check model; if absent, PEAD uses conservative fallback.
RELATION_MODEL_API_KEY=
RELATION_MODEL_ENDPOINT=
RELATION_MODEL_ID=
VIDEOGUARD_DB=./data/reviews.db

# --- PEAD relation parameters (optional; see src/config.py) ---
# These are uncalibrated defaults, not measured reliability. If you override one,
# also update config/policies_v03.json's max_relation_gap_ms: the two must agree,
# otherwise startup fails loudly instead of selecting pairs by one window and
# judging them by another.
# RELATION_GAP_MS=15000
# RELATION_MIN_CHOICE_CONFIDENCE=0.85
# RELATION_MAX_REVIEW_PROBABILITY=0.49
